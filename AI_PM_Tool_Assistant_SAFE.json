        "jsCode": "let rawText = items[0].json.content[0].text;\nrawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch(e) {\n  return [{ json: { error: 'Parse failed', raw: rawText } }];\n}\n\nif (!Array.isArray(parsed)) {\n  return [{ json: { error: 'Not an array', raw: rawText } }];\n}\n\nreturn parsed.map(item => ({ json: item }));"
