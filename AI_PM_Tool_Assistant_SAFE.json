    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst data = allItems[0].json;\n\n// Debug — log all keys so we can see exact field names\nconst keys = Object.keys(data);\n\n// Find each field by searching for any part of the key\nconst findField = (searchTerm) => {\n  const key = keys.find(k => k.toLowerCase().includes(searchTerm.toLowerCase()));\n  return key ? data[key] : 'Unknown';\n};\n\nconst projectName = findField('project name');\nconst status = findField('overall status');\nconst milestones = findField('milestone');\nconst topRisk = findField('top risk');\nconst nextSteps = findField('next step');\nconst audience = findField('update for');\n\nreturn [{\n  json: {\n    projectName: projectName,\n    status: status,\n    milestones: milestones,\n    topRisk: topRisk,\n    nextSteps: nextSteps,\n    audience: audience,\n    claudeBody: {\n      model: 'claude-sonnet-4-5-20250929',\n      max_tokens: 1000,\n      system: `You are a senior program manager writing a weekly executive status update.\nUse the inputs to write a concise professional update of no more than 150 words.\nStructure it exactly like this:\n1. Status: [RED/AMBER/GREEN] and one sentence summary.\n2. Progress: what was completed this week.\n3. Risk: the top risk and what is being done about it.\n4. Next Steps: what happens next week.\nTone: direct, formal, no filler words.\nWrite in short paragraphs. Do not use bullet points.\nDo not wrap response in markdown. Return plain text only.`,\n      messages: [{\n        role: 'user',\n        content: 'Project: ' + projectName +\n          '. Overall status: ' + status +\n          '. Milestones completed this week: ' + milestones +\n          '. Top risk: ' + topRisk +\n          '. Next steps: ' + nextSteps +\n          '. This update is for: ' + audience\n      }]\n    }\n  }\n}];"
      },
