    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst meetingNotes = data.meetingNotes || 'No notes found';\nconst meetingName = $('Google Drive Trigger').first().json.name || 'Meeting from Drive';\nconst meetingDate = new Date().toLocaleDateString();\n\nreturn [{\n  json: {\n    meetingName: meetingName,\n    claudeBody: {\n      model: 'claude-haiku-4-5',\n      max_tokens: 1000,\n      system: `You are a project management assistant. Read the meeting notes provided and extract every Risk, Action, Issue, and Decision. Return ONLY a valid JSON array. Each item must have exactly these fields: type (use only Risk or Action or Issue or Decision), description, owner, due_date, priority (use only High or Medium or Low). If a field is unknown write Unknown. Return nothing else. No explanation. No preamble. Just the array. Do not wrap your response in markdown code blocks. Return raw JSON only.`,\n      messages: [{\n        role: 'user',\n        content: 'Meeting: ' + meetingName + ' on ' + meetingDate + '. Notes: ' + meetingNotes\n      }]\n    }\n  }\n}];"
      },
