        "jsCode": "try {\n  let rawText = items[0].json.content[0].text;\n  rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n  const parsed = JSON.parse(rawText);\n\n  if (Array.isArray(parsed) && parsed.length > 0) {\n    return parsed.map(item => ({ json: item }));\n  } else {\n    return [{ json: {\n      risk_title: 'Error',\n      description: 'Claude returned empty array',\n      severity: 'Unknown',\n      likelihood: 'Unknown',\n      suggested_mitigation: 'Unknown'\n    }}];\n  }\n} catch(e) {\n  return [{ json: {\n    risk_title: 'Error',\n    description: e.message,\n    severity: 'Unknown',\n    likelihood: 'Unknown',\n    suggested_mitigation: 'Unknown'\n  }}];\n}"
      },
